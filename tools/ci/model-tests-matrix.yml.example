# Example only. Not active: it lives outside .github/workflows on purpose.
# To use it, copy it to .github/workflows/model-tests-matrix.yml with a token
# that can write workflows. Goal: run the AIce#9 model and adapter tests on
# Python 3.9, 3.10 and 3.11. Python 3.9 skips tests/test_aice_model.py, which
# fails at import on 3.9 (the project requires 3.10 or newer).
name: Concurrency model tests (matrix)

on:
  pull_request:

permissions:
  contents: read

jobs:
  test:
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        python-version: ['3.9', '3.10', '3.11']
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}
      - run: python -m pip install pytest flake8 numpy
      - run: python -m flake8 src tests tools --select=E9,F63,F7,F82
      - if: matrix.python-version == '3.9'
        run: PYTHONPATH=src python -m pytest -q --ignore=tests/test_aice_model.py
      - if: matrix.python-version != '3.9'
        run: PYTHONPATH=src python -m pytest -q
