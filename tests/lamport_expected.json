  "safe_model_expectations": {
    "invariants_hold_in_every_explored_configuration": ["I1", "I2", "I3", "I4", "I5", "I6", "I7", "U1"],
    "no_deadlock_outside_goal_in_every_explored_configuration": true,
    "every_state_can_reach_committed_or_blocked_with_reason": true,
    "_note": "The two progress statements are reachability checks over a bounded graph. They are necessary for the fairness-conditional claim [](Accepted => <>(Committed or BlockedWithReason)); they are not that claim."
  },
