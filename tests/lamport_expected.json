    "custody_membership_matches_model_for_every_registry_log": true,
    "flag_only_supersession_refused_with_verifier": true,
    "flag_only_supersession_accepted_without_verifier": true,
    "replayed_supersession_token_accepted_by_scorer": true,
    "scorer_has_no_representation_of": ["snapshot_version", "policy_version", "commit_version", "idempotent_commit", "worker_crash_retry", "interleaving", "UNKNOWN_class", "freshness"]
