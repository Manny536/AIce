  "unsafe_variants": {
    "_how_to_read": "Each variant is a deliberately broken protocol. 'config' names an exploration configuration; 'must_violate' lists invariants that the bounded explorer must find violated, each with a counterexample trace. Other invariants may or may not also fail.",
    "no_idempotent_commit": {"config": "race", "must_violate": ["I2"], "issue_flaw": "no idempotent commit"},
    "non_atomic_commit": {"config": "race", "must_violate": ["I2"], "issue_flaw": "simultaneous read/modify/write on the store (check and put are separate steps)"},
    "blank_as_inactive": {"config": "blank", "must_violate": ["I1", "I3"], "issue_flaw": "blank activity treated as inactive"},
    "future_as_active": {"config": "future_only", "must_violate": ["I1"], "issue_flaw": "future date counted active"},
    "stale_overwrites": {"config": "bump", "must_violate": ["I5"], "issue_flaw": "stale commit overwriting newer"},
    "trust_authorized_flag": {"config": "authority", "must_violate": ["I4"], "issue_flaw": "authorized=true field accepted as authority"},
    "no_recall": {"config": "recall", "must_violate": ["I4"], "issue_flaw": "a correction after release leaves the release standing"},
    "gate_uses_worker_view": {"config": "hold", "must_violate": ["I4"], "issue_flaw": "the gate reads the worker's copy of the obligations, not the shared registry"},
    "no_scope_check": {"config": "evidence", "must_violate": ["I3"], "issue_flaw": "evidence about another scope accepted"},
    "partial_as_complete": {"config": "partial", "must_violate": ["I1"], "issue_flaw": "an incomplete snapshot treated as complete"},
    "compensating_report": {"config": "report", "must_violate": ["I6"], "issue_flaw": "a claimed speed or cost gain lets a report pass despite a failed gate"},
    "scope_blind_holds": {"config": "leak", "must_violate": ["U1"], "issue_flaw": "a correction for another seat blocks this seat (custody leakage across branches)"}
  },
